# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://*.vercel.app","https://*.render.com"]

# Database — Supabase PostgreSQL (asyncpg only — no SQLite)
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
# Change [YOUR-PASSWORD] to your actual database password
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase — Auth & Client SDK
# All values from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server-side only, bypasses RLS. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# anon/public key — safe for frontend supabase-js client
SUPABASE_ANON_KEY=your-supabase-anon-key
# JWT Secret — from: Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Engine Configuration
DEFAULT_EXPECTED_DWELL_MINUTES=120
HISTORICAL_VISITS_THRESHOLD=10
GPS_DEBOUNCE_POINTS=2
SEVERITY_HIGH_MULTIPLIER=1.5
SEVERITY_MEDIUM_MULTIPLIER=1.2

# AI / LLM Engine (Groq)
# Get your API key from: https://console.groq.com/keys
# Required for /ai/corridor-analysis and /ai/copilot-query endpoints.
# If not set, AI features will return a graceful error response.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
