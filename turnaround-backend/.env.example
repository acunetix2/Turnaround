# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://*.vercel.app","https://*.render.com"]

# Database — Supabase PostgreSQL (asyncpg only — no SQLite)
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
# Change [YOUR-PASSWORD] to your actual database password
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase — Auth & Client SDK
# All values from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://rqwheweyhxyuhwswcmad.supabase.co
# service_role key — server-side only, bypasses RLS. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJxd2hld2V5aHh5dWh3c3djbWFkIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzgyOTcxMSwiZXhwIjoyMTAzNDA1NzExfQ.w8ldyU0rjVZnC4oWS8RMLt70MUCep27JM3g6A0s3JBo
# anon/public key — safe for frontend supabase-js client
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJxd2hld2V5aHh5dWh3c3djbWFkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4Mjk3MTEsImV4cCI6MjEwMzQwNTcxMX0.0mqPwTXUl6AKjLpMGGm7zjOqKbAEVNwWw4maKQ3UoU4
