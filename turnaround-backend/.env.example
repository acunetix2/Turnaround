# Engine Configuration
DEFAULT_EXPECTED_DWELL_MINUTES=120
HISTORICAL_VISITS_THRESHOLD=10
GPS_DEBOUNCE_POINTS=2
SEVERITY_HIGH_MULTIPLIER=1.5
SEVERITY_MEDIUM_MULTIPLIER=1.2
