# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Get both values from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# anon/public key — safe to expose to the browser
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Company ID used to display that company's published legal documents publicly.
VITE_PUBLIC_COMPANY_ID=

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
# Firebase Console -> Project settings -> Your apps -> Web app configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run the app fully offline with fixture data (no backend needed).
# Set to "false" (or remove) to use the live FastAPI backend.
VITE_USE_MOCKS=false

# ── Map ───────────────────────────────────────────────────────────────────────
# Optional: CARTO API key for vector tile map styles (Voyager / Dark Matter GL).
# Without this key the app falls back to raster OSM/CARTO tiles — fully functional
# but without vector quality. Get a free key at https://carto.com/developers
VITE_CARTO_API_KEY=
